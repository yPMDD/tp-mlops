4. TP 3 - ENREGISTRER MODÈLES ET ARTEFACTS DANS MLflow
--------------------------------------------------------------------------------

Objectifs pédagogiques :
- Journaliser paramètres, métriques, tags et artefacts d'une exécution
- Packager un modèle avec sa signature et son environnement d'exécution
- Enregistrer plusieurs versions dans le registre et les faire évoluer par alias
- Effectuer un retour arrière sans reconstruire ni redéployer
- Servir le modèle promu en HTTP et l'appeler depuis un client

--------------------------------------------------------------------------------
4.1 Journalisation complète d'une exécution
--------------------------------------------------------------------------------

Commande exécutée (Phase B - comparaison d'algorithmes) :

python << CODE_PYTHON >>
import mlflow
mlflow.set_tracking_uri('http://127.0.0.1:5000')
mlflow.set_experiment('synthese-medicaments')

import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.svm import SVC
from sklearn.neighbors import KNeighborsClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import f1_score, precision_score, recall_score

df = pd.read_csv('data/medicaments_clean.csv')

X = df[['PPV_NUM', 'DOSAGE1_NUM', 'TAUX_REMBOURSEMENT_NUM']]
y = df['target']
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.25, random_state=42)

# 1. RandomForest
with mlflow.start_run(run_name='RandomForest-medicament') as run:
    model = RandomForestClassifier(random_state=42)
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)
    f1 = f1_score(y_test, y_pred, average='weighted')
    precision = precision_score(y_test, y_pred, average='weighted')
    recall = recall_score(y_test, y_pred, average='weighted')
    mlflow.log_param('model', 'RandomForest')
    mlflow.log_metric('f1_score', f1)
    mlflow.log_metric('precision', precision)
    mlflow.log_metric('recall', recall)
    mlflow.sklearn.log_model(model, 'model', skops_trusted_types=['sklearn.tree._tree.Tree'])
    print('RandomForest: F1=', f1, 'Run ID:', run.info.run_id)

# 2. LogisticRegression
with mlflow.start_run(run_name='logistic-regression-medicament') as run:
    model = LogisticRegression(random_state=42, max_iter=1000)
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)
    f1 = f1_score(y_test, y_pred, average='weighted')
    precision = precision_score(y_test, y_pred, average='weighted')
    recall = recall_score(y_test, y_pred, average='weighted')
    mlflow.log_param('model', 'LogisticRegression')
    mlflow.log_metric('f1_score', f1)
    mlflow.log_metric('precision', precision)
    mlflow.log_metric('recall', recall)
    mlflow.sklearn.log_model(model, 'model', skops_trusted_types=['sklearn.tree._tree.Tree'])
    print('LogisticRegression: F1=', f1, 'Run ID:', run.info.run_id)

# 3. SVC
with mlflow.start_run(run_name='svc-medicament') as run:
    from sklearn.svm import SVC
    model = SVC(random_state=42, probability=True)
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)
    f1 = f1_score(y_test, y_pred, average='weighted')
    precision = precision_score(y_test, y_pred, average='weighted')
    recall = recall_score(y_test, y_pred, average='weighted')
    mlflow.log_param('model', 'SVC')
    mlflow.log_metric('f1_score', f1)
    mlflow.log_metric('precision', precision)
    mlflow.log_metric('recall', recall)
    mlflow.sklearn.log_model(model, 'model', skops_trusted_types=['sklearn.tree._tree.Tree'])
    print('SVC: F1=', f1, 'Run ID:', run.info.run_id)

# 4. KNeighbors
with mlflow.start_run(run_name='knn-medicament') as run:
    model = KNeighborsClassifier()
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)
    f1 = f1_score(y_test, y_pred, average='weighted')
    precision = precision_score(y_test, y_pred, average='weighted')
    recall = recall_score(y_test, y_pred, average='weighted')
    mlflow.log_param('model', 'KNeighbors')
    mlflow.log_metric('f1_score', f1)
    mlflow.log_metric('precision', precision)
    mlflow.log_metric('recall', recall)
    mlflow.sklearn.log_model(model, 'model', skops_trusted_types=['sklearn.tree._tree.Tree'])
    print('KNeighbors: F1=', f1, 'Run ID:', run.info.run_id)
CODE_PYTHON

